# База данных
app.db
*.sqlite
*.sqlite3

# Виртуальное окружение Python
# Исключает папки, которые обычно используются для виртуальных окружений
venv/
.venv/
env/
ENV/
*/venv/
*/.venv/
env.bak/
venv.bak/

# Секреты и конфигурация, специфичная для окружения
.env
*.env
config.py # Если у вас есть отдельный файл конфигурации, который не должен быть в Git

# Кэш и временные файлы Python
__pycache__/
*.py[cod]
*.pyo
*$py.class

# Загруженные файлы (если они хранятся внутри проекта, а не в отдельном томе)
# Если папки uploads и static/thumbnails находятся ВНУТРИ папки проекта
# и вы не хотите их версионировать (обычно так и делают)
uploads/
static/thumbnails/

# Логи
*.log
logs/

# Результаты сборки/дистрибуции (если используется)
dist/
build/
*.egg-info/
*.egg

# Файлы операционной системы
.DS_Store
Thumbs.db

# Файлы IDE/Редактора (наиболее популярные)
.idea/
.vscode/
*.swp
*~